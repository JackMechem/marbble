---
// The app icon and site title, with the alpha badge that's on every page of the docs. The title
// leads to the landing page.
import anchors from "../generated/anchors.json";
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const limitations = `${import.meta.env.BASE_URL.replace(/\/$/, "")}${anchors["docs/USER_GUIDE.md"]["20-known-limitations"]}`;
---

<div class="mb-title">
  <a class="site-title" href={siteTitleHref}>
    <img src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} width="26" height="26" alt="" />
    <span translate="no">{siteTitle}</span>
  </a>
  <a class="mb-alpha" href={limitations} title="Marbble is alpha software: see the known limitations">Alpha</a>
</div>

<style>
  .mb-title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
  }
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .mb-alpha {
    flex: none;
    font: 600 0.625rem/1 var(--sl-font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--mb-badge-ink);
    background: var(--mb-badge);
    padding: 0.28rem 0.4rem;
    border-radius: 2px;
  }
</style>

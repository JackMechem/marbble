---
// The site title as the inverted block that starts the top bar, as on jackmechem.dev, with the
// alpha tag that's on every page of the docs. The title leads to the landing page.
import anchors from "../generated/anchors.json";
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const limitations = `${import.meta.env.BASE_URL.replace(/\/$/, "")}${anchors["docs/USER_GUIDE.md"]["20-known-limitations"]}`;
---

<div class="mb-title">
  <a class="site-title" href={siteTitleHref}>
    <img src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} width="24" height="24" alt="" />
    <span translate="no">{siteTitle}</span>
  </a>
  <a class="mb-alpha" href={limitations} title="Marbble is alpha software: see the known limitations">Alpha</a>
</div>

<style>
  .mb-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    height: 100%;
  }
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    height: 100%;
    padding: 0 1rem;
    background: var(--ink);
    color: var(--paper);
    font: 700 1.5rem/1 var(--display);
    font-stretch: var(--display-stretch);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  .site-title:focus-visible {
    outline-offset: -3px;
  }
  .site-title img {
    height: 24px;
    width: 24px;
  }
  /* The one yellow fill in the docs: small, and its text is ink. */
  .mb-alpha {
    flex: none;
    font: 600 0.6875rem/1 var(--text);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: #100f0d;
    background: var(--yellow);
    padding: 0.32rem 0.45rem 0.3rem;
  }
  .mb-alpha:hover {
    background: var(--ink);
    color: var(--paper);
  }
</style>

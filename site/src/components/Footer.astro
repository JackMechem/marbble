---
// Starlight's footer (edit link, pagination), then the licence, as the landing page's footer has.
import Default from "@astrojs/starlight/components/Footer.astro";
import { REPO_URL } from "../../docs.config.mjs";
---

<Default />
<p class="mb-licence">
  Marbble is released under the <a href={`${REPO_URL}/blob/main/LICENSE`} rel="noopener">MIT licence</a>.
  <a href={REPO_URL} rel="noopener">Source on GitHub</a>.
</p>

<style>
  .mb-licence {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .mb-licence a {
    color: inherit;
  }
</style>

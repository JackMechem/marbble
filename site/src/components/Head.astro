---
// Mermaid is large, so it loads only on a page with a diagram. Without JavaScript the diagram's
// source stays readable as text.
import Default from "@astrojs/starlight/components/Head.astro";
---

<Default />
<script>
  const blocks = [...document.querySelectorAll<HTMLElement>("pre.mermaid")];
  if (blocks.length) {
    const sources = blocks.map((b) => b.textContent ?? "");
    const { default: mermaid } = await import("mermaid");
    const draw = async () => {
      const dark = document.documentElement.dataset.theme !== "light";
      // The site's paper and ink (styles/tokens.css).
      const font = "Instrument Sans Variable, sans-serif";
      mermaid.initialize({
        startOnLoad: false,
        theme: "base",
        themeVariables: dark
          ? { darkMode: true, background: "#100f0d", primaryColor: "#1a1916", primaryTextColor: "#ebe3d2", primaryBorderColor: "#9c9586", lineColor: "#9c9586", secondaryColor: "#24221e", tertiaryColor: "#161513", edgeLabelBackground: "#100f0d", fontFamily: font }
          : { background: "#ebe3d2", primaryColor: "#f3eee3", primaryTextColor: "#100f0d", primaryBorderColor: "#5f5a50", lineColor: "#5f5a50", secondaryColor: "#e2d9c5", tertiaryColor: "#f3eee3", edgeLabelBackground: "#ebe3d2", fontFamily: font },
      });
      blocks.forEach((b, i) => {
        b.removeAttribute("data-processed");
        b.textContent = sources[i];
      });
      await mermaid.run({ nodes: blocks });
    };
    await draw();
    new MutationObserver(draw).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  }
</script>

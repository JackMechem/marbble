---
// Starlight's sidebar under a switch between the zones of the docs, so that who a page is for is
// the first thing in the navigation, on a phone too.
import Default from "@astrojs/starlight/components/Sidebar.astro";
import { ZONES } from "../../docs.config.mjs";
const area = Astro.locals.starlightRoute.id.split("/")[0];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<nav class="mb-zones" aria-label="Documentation sections">
  {
    ZONES.map((z) => (
      <a href={`${base}${z.href}`} aria-current={z.areas.includes(area) ? "true" : undefined}>
        <small>{z.audience}</small>
        <span>{z.label}</span>
      </a>
    ))
  }
</nav>
<Default />

<style>
  /* Ruled rows; the current zone is inverted with a yellow edge, like the current page below. */
  .mb-zones {
    display: grid;
    margin: 0 0 1.25rem;
    border: 1px solid var(--rule);
  }
  .mb-zones a {
    display: grid;
    gap: 0.3rem;
    padding: 0.6rem 0.75rem 0.65rem;
    color: var(--ink);
    text-decoration: none;
  }
  .mb-zones a + a {
    border-top: 1px solid var(--rule);
  }
  .mb-zones a:hover {
    background: var(--tint);
  }
  .mb-zones a:focus-visible {
    outline-offset: -3px;
  }
  .mb-zones span {
    font: 700 1.25rem/1 var(--display);
    font-stretch: var(--display-stretch);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .mb-zones small {
    font: 600 0.6875rem/1 var(--text);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .mb-zones a[aria-current] {
    background: var(--ink);
    color: var(--paper);
    box-shadow: inset 4px 0 0 var(--yellow);
  }
  .mb-zones a[aria-current] small {
    color: inherit;
    opacity: 0.7;
  }
</style>

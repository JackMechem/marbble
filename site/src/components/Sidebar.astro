---
// Starlight's sidebar under a switch between the zones of the docs, so that who a page is for is
// the first thing in the navigation, on a phone too.
import Default from "@astrojs/starlight/components/Sidebar.astro";
import { ZONES } from "../../docs.config.mjs";
const area = Astro.locals.starlightRoute.id.split("/")[0];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<nav class="mb-zones" aria-label="Documentation sections">
  {
    ZONES.map((z) => (
      <a href={`${base}${z.href}`} aria-current={z.areas.includes(area) ? "true" : undefined}>
        <small>{z.audience}</small>
        <span>{z.label}</span>
      </a>
    ))
  }
</nav>
<Default />

<style>
  .mb-zones {
    display: grid;
    gap: 1px;
    margin: 0 0 1rem;
    background: var(--sl-color-hairline-light);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 4px;
    overflow: hidden;
  }
  .mb-zones a {
    display: grid;
    gap: 0.2rem;
    padding: 0.5rem 0.7rem 0.55rem;
    background: var(--sl-color-bg-sidebar);
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .mb-zones a:hover {
    background: var(--sl-color-gray-5);
  }
  .mb-zones span {
    font-weight: 600;
    font-size: var(--sl-text-sm);
  }
  .mb-zones small {
    font: 500 0.625rem/1 var(--sl-font-mono);
    letter-spacing: 0.04em;
    color: var(--sl-color-gray-3);
  }
  .mb-zones a[aria-current] {
    box-shadow: inset 3px 0 0 var(--sl-color-accent);
    color: var(--sl-color-white);
  }
</style>

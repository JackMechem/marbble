{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marbble",
  "version": "0.1.0-alpha.7",
  "identifier": "io.github.jackmechem.marbble",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Marbble",
        "width": 1480,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 620,
        "backgroundColor": "#1c1c1e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright (c) 2026 Jack Mechem",
    "license": "MIT",
    "resources": {
      "../LICENSE": "LICENSE"
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}